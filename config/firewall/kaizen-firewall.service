[Unit]
Description=Kaizen host firewall (nftables table inet kaizen_firewall)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/kaizen/kaizen-firewall.nft
# Remove only Kaizen's table; never `flush ruleset` (that wipes Docker's rules).
ExecStop=/usr/sbin/nft delete table inet kaizen_firewall

[Install]
WantedBy=multi-user.target
