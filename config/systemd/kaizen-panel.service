[Unit]
Description=Kaizen control panel (https://<hostname>.local:8443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kaizen
# Same checkout and venv as kaizen.service, but its own process: if either
# crashes, the other keeps running.
ExecStart=%h/kaizen/.venv/bin/python -m panel
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
